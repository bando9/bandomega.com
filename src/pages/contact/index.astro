---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BaseHead from "../../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-bg-dark text-text">
    <Header />

    <main class="mt-25 md:mt-35">
      <section class="mt-20 md:mx-25 mx-5">
        <div class="title text-center">
          <h1
            class="title-600-48 bg-gradient-to-r from-primary from-30% to-accent text-transparent bg-clip-text inline-block"
          >
            Contact
          </h1>
          <p class="body-large-400-18 text-text-muted">
            Let’s connect! Whether it’s about tech, collaboration, or just
            sharing ideas - here’s where you can reach me.
          </p>
        </div>
      </section>

      <section class="mt-20 md:mx-25 mx-5">
        <form
          class="bg-bg-light px-5 py-5 md:px-15 md:py-15 w-full md:w-150 flex flex-col gap-10 mx-auto rounded-lg"
        >
          <div class="w-full">
            <label for="name"> Name </label>
            <input
              id="name"
              type="text"
              placeholder="John Doe"
              class="bg-bg-dark py-2 px-3 mt-3 rounded-lg w-full"
            />
          </div>

          <div class="w-full">
            <label for="email">Email Address</label>
            <input
              id="email"
              type="email"
              placeholder="example@email.com"
              class="bg-bg-dark py-2 px-3 mt-3 rounded-lg w-full"
            />
          </div>

          <div class="w-full">
            <label for="subject"> Subject </label>
            <input
              id="subject"
              type="text"
              placeholder="Inquiry about collaboration"
              class="bg-bg-dark py-2 px-3 mt-3 rounded-lg w-full"
            />
          </div>

          <div class="w-full">
            <label for="message"> Message </label>
            <textarea
              id="message"
              placeholder="Write your message here.."
              class="bg-bg-dark py-2 px-3 mt-3 rounded-lg w-full h-25 resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="py-3 px-8 bg-button w-50 mx-auto rounded-lg cursor-pointer"
          >
            Send Message
          </button>
        </form>
      </section>
    </main>

    <Footer />

    <!-- <script src="/src/script.js"></script> -->
  </body>
</html>
