---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BaseHead from "../../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("project")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-bg-dark text-text">
    <Header />

    <main class="mt-25 md:mt-35">
      <section class="mt-20 md:mx-25 mx-5">
        <div class="title text-center">
          <h1
            class="title-600-48 bg-gradient-to-r from-primary from-30% to-accent text-transparent bg-clip-text inline-block"
          >
            Projects
          </h1>
          <p class="body-large-400-18 text-text-muted">
            A collection of projects I’ve built to sharpen my skills and explore
            ideas.
          </p>
        </div>
      </section>

      <section class="mt-20 md:mx-25 mx-5">
        <div class="projects-list mt-7 md:mt-13 flex flex-col gap-10 md:gap-20">
          <div
            class="project-card-left flex flex-col md:flex-row items-start md:justify-between gap-6"
          >
            <div class="order-1 w-full md:w-md">
              <img
                src="/images/project-1.png"
                alt="Photo Personal Web v1"
                class="rounded-lg w-full h-auto"
              />
            </div>

            <div class="order-2 md:order-1 md:w-2/3">
              <h1
                class="subtitle-600-20 md:subtitle-600-24 mb-2 group-hover:underline"
              >
                Bandomega Personal Website
              </h1>
              <h3 class="caption-500-14">
                A personal portfolio website showcasing projects, GitHub links,
                and project highlights. Built with HTML5 and Bootstrap.
              </h3>

              <div class="flex mt-3 gap-2 md:gap-4 items-center">
                <h3 class="caption-500-14">Tools:</h3>
                <div class="flex gap-3">
                  <img
                    src="/images/stack/html5.svg"
                    alt="HTML Icon"
                    class="w-5"
                  />
                  <img src="/images/stack/css.svg" alt="CSS Icon" class="w-5" />
                  <img
                    src="/images/stack/bootstrap.svg"
                    alt="Bootstrap Icon"
                    class="w-6"
                  />
                </div>
              </div>

              <div
                class="flex flex-col md:flex-row md:items-center md:justify-between mt-5 gap-4"
              >
                <div class="flex items-center gap-5 order-2 md:order-1">
                  <a
                    href="https://github.com/bando9/bandomega-portfolio/tree/main"
                    target="_blank"
                    class="flex items-center gap-1 hover:underline"
                  >
                    <img
                      src="/images/stack/github.svg"
                      alt="GitHub Icon"
                      class="w-5"
                    />
                    <p class="caption-500-14">Repository</p>
                  </a>
                  <a
                    href="https://v1.bandomega.com/"
                    target="_blank"
                    class="flex items-center gap-1 hover:underline"
                  >
                    <img
                      src="/images/icons/link-1.svg"
                      alt="Link Icon"
                      class="w-5"
                    />
                    <p class="caption-500-14">Open link sites</p>
                  </a>
                </div>

                <a href="/projects/project-details" class="order-1 md:order-2">
                  <div class="flex items-center gap-1 hover:underline">
                    <p class="caption-500-14">View project</p>
                    <img
                      src="/images/icons/arrow-right.svg"
                      alt="Arrow right icon"
                      class="w-5"
                    />
                  </div>
                </a>
              </div>
            </div>
          </div>

          <div
            class="project-card-right flex flex-col md:flex-row items-start md:justify-between gap-6"
          >
            <div class="order-2 md:order-1 md:w-2/3">
              <h1
                class="subtitle-600-20 md:subtitle-600-24 mb-2 group-hover:underline"
              >
                Memomate – Daily Notes App
              </h1>
              <h3 class="caption-500-14">
                A simple web app for creating and managing daily notes. Built
                with ReactJS and modular styling.
              </h3>

              <div class="flex mt-3 gap-2 md:gap-4 items-center">
                <h3 class="caption-500-14">Tools:</h3>
                <div class="flex gap-3">
                  <img
                    src="/images/stack/react.svg"
                    alt="HTML Icon"
                    class="w-5"
                  />
                </div>
              </div>

              <div
                class="flex flex-col md:flex-row md:items-center md:justify-between mt-5 gap-4"
              >
                <div class="flex items-center gap-5 order-2 md:order-1">
                  <a
                    href="https://github.com/bando9/memomate"
                    target="_blank"
                    class="flex items-center gap-1 hover:underline"
                  >
                    <img
                      src="/images/stack/github.svg"
                      alt="GitHub Icon"
                      class="w-5"
                    />
                    <p class="caption-500-14">Repository</p>
                  </a>
                  <a
                    href="https://memomate-six.vercel.app/"
                    target="_blank"
                    class="flex items-center gap-1 hover:underline"
                  >
                    <img
                      src="/images/icons/link-1.svg"
                      alt="Link Icon"
                      class="w-5"
                    />
                    <p class="caption-500-14">Open link sites</p>
                  </a>
                </div>

                <a href="/projects/project-details" class="order-1 md:order-2">
                  <div class="flex items-center gap-1 hover:underline">
                    <p class="caption-500-14">View project</p>
                    <img
                      src="/images/icons/arrow-right.svg"
                      alt="Arrow right icon"
                      class="w-5"
                    />
                  </div>
                </a>
              </div>
            </div>

            <div class="order-1 w-full md:w-md">
              <img
                src="/images/project-2.jpg"
                alt="Photo Memomate"
                class="rounded-lg w-full h-auto"
              />
            </div>
          </div>

          <div
            class="project-card-right flex flex-col md:flex-row items-start md:justify-between gap-6"
          >
            <div class="order-1 w-full md:w-md">
              <img
                src="/images/project-3.jpg"
                alt="Photo Memomate"
                class="rounded-lg w-full h-auto"
              />
            </div>

            <div class="order-2 md:order-1 md:w-2/3">
              <h1
                class="subtitle-600-20 md:subtitle-600-24 mb-2 group-hover:underline"
              >
                Mini Library – Book CRUD Application
              </h1>
              <h3 class="caption-500-14">
                A personal portfolio website showcasing projects, GitHub links,
                and project highlights. Built with HTML5 and Bootstrap.
              </h3>

              <div class="flex mt-3 gap-2 md:gap-4 items-center">
                <h3 class="caption-500-14">Tools:</h3>
                <div class="flex gap-3">
                  <img
                    src="/images/stack/html5.svg"
                    alt="HTML Icon"
                    class="w-5"
                  />

                  <img src="/images/stack/css.svg" class="w-5" alt="CSS Icon" />

                  <img
                    src="/images/stack/javascript.svg"
                    class="w-5"
                    alt="JavaScript Icon"
                  />
                </div>
              </div>

              <div
                class="flex flex-col md:flex-row md:items-center md:justify-between mt-5 gap-4"
              >
                <div class="flex items-center gap-5 order-2 md:order-1">
                  <a
                    href="https://github.com/bando9/perpustakaan-mini"
                    target="_blank"
                    class="flex items-center gap-1 hover:underline"
                  >
                    <img
                      src="/images/stack/github.svg"
                      alt="GitHub Icon"
                      class="w-5"
                    />
                    <p class="caption-500-14">Repository</p>
                  </a>
                  <a
                    href="https://perpustakaan-mini.vercel.app/"
                    target="_blank"
                    class="flex items-center gap-1 hover:underline"
                  >
                    <img
                      src="/images/icons/link-1.svg"
                      alt="Link Icon"
                      class="w-5"
                    />
                    <p class="caption-500-14">Open link sites</p>
                  </a>
                </div>

                <a href="/projects/project-details" class="order-1 md:order-2">
                  <div class="flex items-center gap-1 hover:underline">
                    <p class="caption-500-14">View project</p>
                    <img
                      src="/images/icons/arrow-right.svg"
                      alt="Arrow right icon"
                      class="w-5"
                    />
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section
        id="contact"
        class="px-5 md:px-25 py-25 md:py-32 flex justify-center items-center"
      >
        <div class="w-full max-w-3xl text-center">
          <h1 class="title-600-48 md:title-600-64">
            Get
            <span
              class="bg-gradient-to-r from-primary from-30% to-accent text-transparent bg-clip-text inline-block"
              >In Touch</span
            >
          </h1>
          <p
            class="body-default-400-16 md:body-large-400-18 text-text-muted max-w-xl mx-auto mt-4"
          >
            While I’m focused on my current journey, my inbox is always open.
            Whether it’s about tech, career, or just a friendly hello, I’d be
            glad to hear from you.
          </p>
          <div class="flex justify-center items-center mt-10">
            <a
              href="/contact"
              class="inline-flex items-center justify-center py-3 px-6 bg-button rounded-2xl heading-700-20 md:heading-700-24 hover:shadow-md hover:shadow-bg-light transition"
              >Say Hello</a
            >
          </div>
        </div>
      </section>

      <section>
        <ul>
          {
            posts.map((post) => (
              <li>
                <a href={`/projects/${post.id}/`}>
                  {post.data.heroImage && (
                    <Image
                      width={720}
                      height={360}
                      src={post.data.heroImage}
                      alt=""
                    />
                  )}
                  <h4 class="title">{post.data.title}</h4>
                  <p class="date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <Footer />

    <!-- <script src="/src/script.js"></script> -->
  </body>
</html>
